    private string OperationTitle => Operation switch { "insert" => "Insert Employee", "update" => "Update Employee", "delete" => "Delete Employee", "bulk" => "Bulk Salary Update", _ => "Employee Operation" };
    private string CrudSql => Operation switch
    {
        "insert" => "INSERT INTO Employees (FirstName, LastName, Email, Department, Salary, HireDate) VALUES (@FirstName, @LastName, @Email, @Department, @Salary, @HireDate);",
        "update" => "UPDATE Employees SET /* supplied fields only */ WHERE EmployeeId = @EmployeeId;",
        "delete" => "DELETE FROM Employees WHERE EmployeeId = @EmployeeId;",
