@page "/"
@page "/database-viewer"
@page "/database-viewer/{TableName}"
@page "/connection-test"
@page "/generic/query-multiple"
@page "/generic/query-single"
@page "/generic/query-json"
@page "/execute-non-query"
@page "/execute-non-query/{Operation}"
@page "/stored-procedures"
@page "/unit-of-work"
@page "/distributed-transaction"
@page "/multi-server"
@page "/cross-server"
@page "/http-data-access"
@page "/composite"
@page "/database-providers"
@page "/configuration"
@page "/documentation"
@page "/sql-queries"
@page "/json-queries"
@page "/advanced-features"
@page "/data-sources"
@page "/Error"
@page "/not-found"
@implements IDisposable
@inject MockDataService Data
@inject DirectLibraryTestService LibraryTests
@inject DatabaseConnectionTestService ConnectionTests
@inject NavigationManager Navigation

<PageTitle>@BrowserTitle</PageTitle>
<main class="content">
    @if (IsDashboard)
    {
        <div class="breadcrumb">Home <span>/</span> Dashboard</div>
        <section class="hero">
            <div class="hero-orb orb-one"></div><div class="hero-orb orb-two"></div>
            <div class="eyebrow">DATAACCESSOR LIBRARY V1.0</div>
            <h1>DataAccessor Library Explorer</h1>
            <p>Explore and test data access patterns from simple SQL queries to distributed transactions and HTTP integrations.</p>
            <div class="hero-pills">
                @foreach (var feature in HeroFeatures) { <span>@feature</span> }
            </div>
            <div class="hero-actions">
                <a class="button light" href="/database-viewer">View Mock Database</a>
                <a class="button outline-light" href="/generic/query-multiple">Run First Query</a>
            </div>
        </section>

        <div class="stats-grid">
            <StatCard Label="Employees" Count="@Data.Employees.Count" Accent="blue" Icon="♙" />
            <StatCard Label="Customers" Count="@Data.Customers.Count" Accent="violet" Icon="♧" />
            <StatCard Label="Products" Count="@Data.Products.Count" Accent="green" Icon="▣" />
            <StatCard Label="Orders" Count="@Data.Orders.Count" Accent="orange" Icon="▤" />
        </div>

        <section class="section">
            <div class="section-title-row"><div><h2>Live Database Previews</h2><p>Sample records from the current in-memory demonstration dataset.</p></div><span class="mock-tag">MOCK DATA</span></div>
            <div class="preview-grid">
                <PreviewCard Title="Employees" Route="/database-viewer/employees" Headers="Name,Department,Salary" Rows="@Data.Employees.Take(3).Select(x => new[] { x.FullName, x.Department, Money(x.Salary) })" />
                <PreviewCard Title="Customers" Route="/database-viewer/customers" Headers="Company,Email,Country" Rows="@Data.Customers.Take(3).Select(x => new[] { x.CustomerName, x.Email, x.Country })" />
                <PreviewCard Title="Products" Route="/database-viewer/products" Headers="Product,Category,Price" Rows="@Data.Products.Take(3).Select(x => new[] { x.ProductName, x.Category, Money(x.Price) })" />
                <PreviewCard Title="Orders" Route="/database-viewer/orders" Headers="Order #,Customer,Status,Total" Rows="@Data.Orders.Take(3).Select(x => new[] { $"#{x.OrderId}", Data.Customers.FirstOrDefault(c => c.CustomerId == x.CustomerId)?.CustomerName ?? "Unknown", x.Status, Money(x.TotalAmount) })" />
            </div>
        </section>

        <section class="section">
            <div class="section-title-row"><div><h2>Feature Pages</h2><p>Focused mock scenarios for the library's data access patterns.</p></div></div>
            <div class="feature-grid">
                @foreach (var item in FeatureLinks)
                {
                    <a class="feature-card @item.Color" href="@item.Route"><span class="feature-icon">@item.Icon</span><h3>@item.Title</h3><code>@item.Contract</code><p>@item.Description</p><span class="card-arrow">Explore →</span></a>
                }

            </div>
        </section>

        <section class="section health-panel">
            <div class="section-title-row"><div><h2>Feature Health Check</h2><p>These checks verify the mock demonstration fixtures only; they do not contact the API or database.</p></div><button class="button primary" @onclick="RunHealthChecks" disabled="@IsBusy">@(IsBusy ? "Running checks..." : "Run All Feature Tests")</button></div>
            @if (HealthResults.Count > 0)
            {
                <div class="health-grid">
                    @foreach (var check in HealthResults)
                    {
                        <div class="health-item"><span class="status-dot @(check.Passed ? "good" : "bad")"></span><div><strong>@check.Name</strong><small>@(check.Passed ? "OK · mock demo" : "FAIL · mock demo") · @check.ElapsedMilliseconds.ToString("F1") ms</small></div></div>
                    }
                </div>
            }
        </section>

        <section class="section health-panel library-test-panel">
            <div class="section-title-row">
                <div><h2>Direct Library Test Suite</h2><p>Invokes the existing DataAccessor.Library methods against temporary in-memory SQLite databases and a local HTTP stub. It does not use the API, configured connection strings, or external services.</p></div>
                <button class="button primary" @onclick="RunLibrarySuite" disabled="@LibraryBusy">@(LibraryBusy ? "Testing Library..." : "Run Direct Library Tests")</button>
            </div>
            <div class="library-safety-note"><strong>Isolated and disposable:</strong> fixture connections are created for this run and released afterwards. Stored procedures are marked unsupported on SQLite; that is not a pass.</div>
            @if (LibraryResults.Count > 0)
            {
                <div class="library-results">
                    @foreach (var result in LibraryResults)
                    {
                        <article class="library-result">
                            <div class="library-result-status @result.Status.ToLowerInvariant()">@result.Status</div>
                            <div class="library-result-body">
                                <div class="section-title-row"><strong>@result.Test</strong><span class="muted">@result.LibraryArea · @result.ElapsedMilliseconds.ToString("F1") ms</span></div>
                                <code>@result.Method</code>
                                <p>@result.Detail</p>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else if (IsViewer)
    {
        <div class="breadcrumb"><a href="/">Dashboard</a> <span>/</span> Database Viewer</div>
        <div class="page-heading-row"><div><h1>Database Viewer</h1><p>Browse deterministic in-memory sample data. Nothing here is introspected from a live database.</p></div><a class="button primary" href="/generic/query-multiple">Query This Data</a></div>
        <div class="notice"><strong>Mock dataset</strong><span>These records reset when the Explorer restarts. They are separate from the CRUD demonstration data.</span></div>
        @if (string.IsNullOrWhiteSpace(TableName))
        {
            <div class="table-card-grid">
                @foreach (var table in Tables)
                {
                    <a class="table-card" href="@($"/database-viewer/{table.Key}")"><span class="table-card-icon">@table.Icon</span><h3>@table.Title</h3><p>@table.Description</p><strong>@table.Count rows</strong><span>View table →</span></a>
                }
                <a class="table-card schema-card" href="/database-viewer/schema"><span class="table-card-icon">⌘</span><h3>Schema</h3><p>Reference DDL-style fields and relationships.</p><strong>23 fields</strong><span>View schema →</span></a>
            </div>
            <section class="panel section"><h2>Relationships</h2><p><code>Orders.CustomerId</code> references <code>Customers.CustomerId</code>. All four mock tables use integer primary keys.</p></section>
        }
        else if (TableName.Equals("schema", StringComparison.OrdinalIgnoreCase))
        {
            <section class="panel">
                <h2>Reference Schema</h2><p class="muted">SQL Server-style reference types; this is not live schema introspection.</p>
                <div class="table-scroll"><table><thead><tr><th>Table</th><th>Column</th><th>Data Type</th><th>Key</th><th>Notes</th></tr></thead><tbody>
                    @foreach (var row in SchemaRows) { <tr><td>@row.Table</td><td><code>@row.Column</code></td><td>@row.Type</td><td>@row.Key</td><td>@row.Notes</td></tr> }
                </tbody></table></div>
            </section>
        }
        else if (TryGetTable(TableName, out var selectedTable, out var selectedRows))
        {
            <div class="page-heading-row table-detail-heading"><div><span class="eyebrow dark">@selectedTable.Icon @selectedTable.Title</span><h2>@selectedTable.Description</h2><p>@selectedTable.Count records · current mock fixture</p></div><a class="button secondary" href="/database-viewer">← All Tables</a></div>
            <section class="panel">
                <div class="toolbar"><label class="search-box">⌕ <input aria-label="Search table records" placeholder="Search records..." @bind="SearchText" @bind:event="oninput" /></label>@if (!string.IsNullOrEmpty(SearchText)) { <button class="button secondary small" @onclick="() => SearchText = string.Empty">Clear</button> }<span class="toolbar-count">@FilteredRows(selectedRows).Count() records</span></div>
                @if (!FilteredRows(selectedRows).Any()) { <div class="empty-state">No records match your search.</div> }
                else { <DynamicTable Rows="FilteredRows(selectedRows).ToList()" /> }
                <div class="panel-foot">Mock records are in memory and reset when the Explorer restarts.</div>
            </section>
        }
        else
        {
            <div class="empty-state error-state"><h2>Table not found</h2><p>The table '@TableName' is not part of this mock dataset.</p><a href="/database-viewer">Return to all tables</a></div>
        }
    }
    else if (CurrentPath == "/generic/query-multiple")
    {
        <PageIntro Breadcrumb="SQL Operations / Query Multiple" Title="Query Multiple Records" Description="Demonstrate QueryAsync<T>() with parameterized filters against the read-only employee fixture." />
        <div class="two-column">
            <section class="panel"><h2>Query Parameters</h2>
                <label>Department<select @bind="Department" @bind:after="ClearQueryResult"><option>All Departments</option>@foreach (var department in Departments) { <option>@department</option> }</select></label>
                <div class="form-row"><label>Minimum salary<input type="number" min="0" step="1000" @bind="MinSalary" @bind:after="ClearQueryResult" /></label><label>Maximum salary<input type="number" min="0" step="1000" @bind="MaxSalary" @bind:after="ClearQueryResult" /></label></div>
                <div class="button-row"><button class="button primary" @onclick="RunMultipleQuery" disabled="@IsBusy">@(IsBusy ? "Querying..." : "Run Query")</button><button class="button secondary" @onclick="ResetQuery">Reset Filters</button></div>
            </section>
            <section class="panel"><h2>Parameterized SQL</h2><pre><code>@MultipleSql</code></pre><h3>Parameters</h3><pre><code>@MultipleParameters</code></pre><span class="mock-tag">MOCK EXECUTION · NO SQL SENT</span></section>
        </div>
        @if (QueryHasRun)
        {
            <section class="panel result-panel"><div class="section-title-row"><h2>Results <span class="count-badge">@QueryEmployees.Count records</span></h2><span class="muted">Completed in @QueryElapsed.ToString("F2") ms · mock</span></div>
                @if (!string.IsNullOrWhiteSpace(QueryError)) { <div class="result-message failure">@QueryError</div> }
                @if (QueryEmployees.Count == 0) { <div class="empty-state">No employees match these filters.</div> }
                else { <EmployeeTable Rows="QueryEmployees" /> }
            </section>
        }
    }
    else if (CurrentPath == "/generic/query-single")
    {
        <PageIntro Breadcrumb="SQL Operations / Query Single" Title="Query Single Record" Description="Look up a single employee. A missing ID returns a genuine not-found result, not a fabricated record." />
        <section class="panel narrow-panel"><h2>Lookup Employee</h2><label>Employee ID<input type="number" min="1" @bind="LookupId" @bind:after="() => SingleHasRun = false" /></label>
            <div class="quick-ids">@foreach (var id in Data.Employees.Select(e => e.EmployeeId).Append(99)) { <button class="chip" @onclick="() => LookupId = id">ID @id@(id == 99 ? " (not found)" : "")</button> }</div>
            <button class="button primary" @onclick="RunSingleQuery" disabled="@IsBusy">@(IsBusy ? "Looking up..." : "Find Employee")</button>
        </section>
        @if (SingleHasRun)
        {
            @if (SingleEmployee is null) { <section class="panel empty-state"><h2>No Record Found</h2><p>No employee exists with ID @LookupId.</p></section> }
            else { <section class="panel profile-card"><div class="avatar">@SingleEmployee.FirstName[..1]@SingleEmployee.LastName[..1]</div><div><span class="mock-tag">MOCK RECORD</span><h2>@SingleEmployee.FullName</h2><p>@SingleEmployee.Email</p><div class="profile-facts"><span>ID <b>@SingleEmployee.EmployeeId</b></span><span>Department <b>@SingleEmployee.Department</b></span><span>Salary <b>@SingleEmployee.Salary.ToString("C0")</b></span><span>Hire date <b>@SingleEmployee.HireDate.ToString("yyyy-MM-dd")</b></span></div></div></section> }
            <p class="query-meta">Query: <code>WHERE EmployeeId = @@EmployeeId</code> · @QueryElapsed.ToString("F2") ms · mock</p>
        }
    }
    else if (CurrentPath == "/generic/query-json" || CurrentPath == "/json-queries")
    {
        <PageIntro Breadcrumb="SQL Operations / Query JSON" Title="Query JSON Results" Description="Run a mock dataset through JSON serialization and inspect the same records as a table or formatted document." />
        <section class="panel"><div class="form-row align-end"><label>Dataset<select @bind="DatasetName" @bind:after="() => JsonHasRun = false">@foreach (var name in DatasetNames) { <option>@name</option> }</select></label><label>Display<select @bind="JsonView">@foreach (var view in new[] { "JSON", "Table" }) { <option>@view</option> }</select></label><button class="button primary" @onclick="RunJsonQuery" disabled="@IsBusy">@(IsBusy ? "Serializing..." : "Run Query")</button></div><p class="muted">@DatasetCount(DatasetName) rows · mock · JsonDocument/JsonElement demonstration</p></section>
        @if (JsonHasRun)
        {
            <section class="panel"><div class="section-title-row"><h2>@DatasetName results</h2><span class="mock-tag">MOCK JSON</span></div>
                @if (JsonView == "JSON") { <pre class="json-output"><code>@JsonResult</code></pre> }
                else { <DynamicTable Rows="DatasetRows(DatasetName)" /> }
            </section>
        }
    }
    else if (CurrentPath.StartsWith("/execute-non-query"))
    {
        @RenderCrud()
    }
    else if (CurrentPath == "/not-found" || CurrentPath == "/Error")
    {
        <div class="breadcrumb"><a href="/">Dashboard</a> <span>/</span> Error</div><section class="panel empty-state"><h1>@(CurrentPath == "/Error" ? "Something went wrong" : "Not Found")</h1><p>@(CurrentPath == "/Error" ? "The Explorer encountered an unexpected error. No sensitive details are displayed." : "Sorry, the content you are looking for does not exist.")</p><a class="button primary" href="/">Return to dashboard</a></section>
    }
    else
    {
        @RenderScenarioPage()
    }
</main>

@code {
    [Parameter] public string? TableName { get; set; }
    [Parameter] public string? Operation { get; set; }

    private string CurrentPath { get; set; } = "/";
    private string BrowserTitle => CurrentPath switch
    {
        "/" => "Dashboard - DataAccessor Explorer",
        "/database-viewer" => "Database Viewer - DataAccessor Explorer",
        "/connection-test" => "Test Connections - DataAccessor Explorer",
        "/generic/query-multiple" => "Query Multiple - DataAccessor Explorer",
        "/generic/query-single" => "Query Single - DataAccessor Explorer",
        "/generic/query-json" or "/json-queries" => "Query JSON - DataAccessor Explorer",
        _ when CurrentPath.StartsWith("/execute-non-query", StringComparison.OrdinalIgnoreCase) => "Execute Non-Query - DataAccessor Explorer",
        "/not-found" => "Not Found - DataAccessor Explorer",
        _ => $"{ScenarioTitle} - DataAccessor Explorer"
    };
    private bool IsDashboard => CurrentPath == "/";
    private bool IsViewer => CurrentPath == "/database-viewer" || CurrentPath.StartsWith("/database-viewer/", StringComparison.OrdinalIgnoreCase);
    private bool IsBusy { get; set; }
    private bool LibraryBusy { get; set; }
    private bool ConnectionBusy { get; set; }
    private List<DatabaseConnectionTestResult> ConnectionResults { get; set; } = [];
    private List<FeatureCheck> HealthResults { get; set; } = [];
    private List<LibraryTestResult> LibraryResults { get; set; } = [];
    private string Department { get; set; } = "All Departments";
    private decimal? MinSalary { get; set; }
    private decimal? MaxSalary { get; set; }
    private bool QueryHasRun { get; set; }
    private List<Employee> QueryEmployees { get; set; } = [];
    private double QueryElapsed { get; set; }
    private string QueryError { get; set; } = "";
    private int LookupId { get; set; } = 1;
    private bool SingleHasRun { get; set; }
    private Employee? SingleEmployee { get; set; }
    private string DatasetName { get; set; } = "Employees";
    private string JsonView { get; set; } = "JSON";
    private bool JsonHasRun { get; set; }
    private string JsonResult { get; set; } = "";
    private string SearchText { get; set; } = "";
    private string FirstName { get; set; } = "";
    private string LastName { get; set; } = "";
    private string Email { get; set; } = "";
    private string CrudDepartment { get; set; } = "Engineering";
    private decimal CrudSalary { get; set; }
    private string UpdateDepartment { get; set; } = "";
    private decimal? UpdateSalary { get; set; }
    private int CrudId { get; set; } = 1;
    private decimal BulkIncreaseAmount { get; set; } = 1000;
    private MutationResult? Mutation { get; set; }
    private string ScenarioOutput { get; set; } = "";
    private string ScenarioInput { get; set; } = "";
    private string ScenarioSelection { get; set; } = "";

    private static readonly string[] HeroFeatures = ["IGenericDataAccess", "IUnitOfWork", "IMultiServerDataAccess", "HttpDataAccess", "CompositeDataAccess", ".NET 8"];
    private static readonly string[] Departments = ["Engineering", "Marketing", "Sales", "Finance", "HR"];
    private static readonly string[] DatasetNames = ["Employees", "Customers", "Products", "Orders"];
    private static readonly (string Name, string Icon, string Package, string Description)[] ProviderDetails =
    [
        ("SQL Server", "▦", "Microsoft.Data.SqlClient", "Microsoft SQL Server relational database."),
        ("PostgreSQL", "🐘", "Npgsql", "Open-source relational database with rich data types."),
        ("MySQL", "◉", "MySqlConnector", "Popular open-source relational database."),
        ("SQLite", "▣", "Microsoft.Data.Sqlite", "Embedded file-based database; stored procedures are not supported.")
    ];
    private static readonly FeatureLink[] FeatureLinks =
    [
        new("Query Multiple", "QueryAsync<T>()", "Parameterized queries with optional filters.", "/generic/query-multiple", "⌕", "blue"),
        new("Query Single", "QuerySingleAsync<T>()", "Find one record or handle a genuine null result.", "/generic/query-single", "◉", "violet"),
        new("Execute Non-Query", "ExecuteAsync()", "Demonstrate isolated in-memory CRUD operations.", "/execute-non-query", "✎", "green"),
        new("Unit of Work", "IUnitOfWork", "Explore transaction scenarios and event logs.", "/unit-of-work", "⇄", "orange"),
        new("Distributed Transaction", "DistributedTransactionManager", "Model coordinated operations across servers.", "/distributed-transaction", "⤳", "rose"),
        new("Multi-Server", "IMultiServerDataAccess", "Compare named-server query patterns.", "/multi-server", "▥", "teal"),
        new("Test Connections", "DatabaseConnectionFactory", "Open two isolated databases and verify seeded data.", "/connection-test", "⇄", "teal")
    ];
    private sealed record FeatureLink(string Title, string Contract, string Description, string Route, string Icon, string Color);
    private sealed record TableInfo(string Key, string Title, string Description, string Icon, int Count);

    private IEnumerable<TableInfo> Tables =>
    [
        new("employees", "Employees", "Employee directory and salary information.", "♙", Data.Employees.Count),
        new("customers", "Customers", "Customer contact and location records.", "♧", Data.Customers.Count),
        new("products", "Products", "Product catalog, pricing and stock.", "▣", Data.Products.Count),
        new("orders", "Orders", "Orders linked to customer records.", "▤", Data.Orders.Count)
    ];

    private static readonly (string Table, string Column, string Type, string Key, string Notes)[] SchemaRows =
    [
        ("Employees","EmployeeId","int","PK","Identity"),("Employees","FirstName","nvarchar(50)","","Required"),("Employees","LastName","nvarchar(50)","","Required"),("Employees","Email","nvarchar(120)","","Unique"),("Employees","Department","nvarchar(50)","",""),("Employees","Salary","decimal(10,2)","",""),("Employees","HireDate","datetime","",""),
        ("Customers","CustomerId","int","PK","Identity"),("Customers","CustomerName","nvarchar(100)","","Required"),("Customers","Email","nvarchar(120)","",""),("Customers","Phone","nvarchar(30)","",""),("Customers","City","nvarchar(80)","",""),("Customers","Country","nvarchar(80)","",""),
        ("Products","ProductId","int","PK","Identity"),("Products","ProductName","nvarchar(120)","","Required"),("Products","Category","nvarchar(50)","",""),("Products","Price","decimal(10,2)","",""),("Products","StockQuantity","int","",""),
        ("Orders","OrderId","int","PK","Identity"),("Orders","CustomerId","int","FK","References Customers.CustomerId"),("Orders","OrderDate","datetime","",""),("Orders","TotalAmount","decimal(10,2)","",""),("Orders","Status","nvarchar(30)","","")
    ];

    private string MultipleSql
    {
        get
        {
            var clauses = new List<string>();
            if (Department != "All Departments") clauses.Add("Department = @Department");
            if (MinSalary.HasValue) clauses.Add("Salary >= @MinSalary");
            if (MaxSalary.HasValue) clauses.Add("Salary <= @MaxSalary");
            return "SELECT EmployeeId, FirstName, LastName, Email, Department, Salary, HireDate\nFROM Employees" +
                (clauses.Count > 0 ? "\nWHERE " + string.Join("\n  AND ", clauses) : "") + "\nORDER BY EmployeeId;";
        }
    }
    private string MultipleParameters => string.Join(", ", new[]
    {
        Department != "All Departments" ? $"Department = \"{Department}\"" : null,
        MinSalary.HasValue ? $"MinSalary = {Money(MinSalary.Value)}" : null,
        MaxSalary.HasValue ? $"MaxSalary = {Money(MaxSalary.Value)}" : null
    }.Where(value => value is not null));

    private string ProviderConnectionString
    {
        get
        {
            var builder = new System.Data.Common.DbConnectionStringBuilder();
            if (ScenarioSelection == "SQLite")
            {
                builder["Data Source"] = string.IsNullOrWhiteSpace(ProviderDatabase) ? "app.db" : ProviderDatabase;
            }
            else
            {
                builder["Server"] = string.IsNullOrWhiteSpace(ProviderHost) ? "localhost" : ProviderHost;
                builder["Database"] = string.IsNullOrWhiteSpace(ProviderDatabase) ? "MyDatabase" : ProviderDatabase;
                if (!string.IsNullOrWhiteSpace(ProviderUser))
                {
                    builder["User ID"] = ProviderUser;
                }
                else if (ScenarioSelection == "SQL Server") builder["Trusted_Connection"] = "True";
            }
            return builder.ConnectionString;
        }
    }

    private string ConfigurationJson => JsonSerializer.Serialize(new
    {
        DataAccess = new
        {
            DefaultSource = ScenarioSelection,
            Http = new { BaseUrl = ScenarioInput },
            Databases = new[]
            {
                new { Name = ConfigConnectionName, Provider = ConfigProvider, ConnectionString = RedactedConfigConnectionString, CommandTimeout = ConfigTimeout }
            }
        }
    }, new JsonSerializerOptions { WriteIndented = true });

    private string RedactedConfigConnectionString
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ConfigConnectionString))
                return "";
            try
            {
                var builder = new System.Data.Common.DbConnectionStringBuilder
                {
                    ConnectionString = ConfigConnectionString
                };
                foreach (var key in builder.Keys.Cast<string>().Where(key =>
                    key.Contains("password", StringComparison.OrdinalIgnoreCase) ||
                    key.Equals("pwd", StringComparison.OrdinalIgnoreCase)))
                {
                    builder[key] = "[redacted]";
                }
                return builder.ConnectionString;
            }
            catch (ArgumentException)
            {
                return "[invalid connection string omitted; preview only]";
            }
        }
    }

    protected override void OnParametersSet() => SyncRoute();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        SyncRoute();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            SyncRoute();
            StateHasChanged();
        });
    }

    private void SyncRoute()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        CurrentPath = path.Length > 1 ? path.TrimEnd('/') : "/";
        SearchText = "";
        QueryHasRun = false;
        QueryError = "";
        SingleHasRun = false;
        JsonHasRun = false;
        Mutation = null;
        ScenarioOutput = "";
        QueryError = "";
        ScenarioSelection = CurrentPath switch
        {
            "/stored-procedures" => "sp_GetEmployeesByDepartment",
            "/unit-of-work" => "Commit Transaction",
            "/distributed-transaction" => "Commit All Servers",
            "/multi-server" => "QueryJson",
            "/cross-server" => "QueryMultipleServersAsync",
            "/http-data-access" => "GET /mock/todos/1",
            "/database-providers" => "SQL Server",
            "/configuration" => "Auto",
            _ => "Employees"
        };
        ScenarioInput = CurrentPath switch
        {
            "/stored-procedures" => "Engineering",
            "/http-data-access" => "/mock/todos/1",
            "/composite" => "SELECT 1 AS Id, 'Test' AS Value",
            "/configuration" => "http://localhost:5000",
            _ => ""
        };
        FirstName = LastName = Email = UpdateDepartment = "";
        UpdateSalary = null;
    }

    private async Task RunHealthChecks()
    {
        IsBusy = true;
        HealthResults.Clear();
        await Task.Delay(150);
        HealthResults = Data.RunHealthChecks().ToList();
        IsBusy = false;
    }

    private async Task RunLibrarySuite()
    {
        LibraryBusy = true;
        LibraryResults = [];
        try
        {
            LibraryResults = (await LibraryTests.RunIsolatedSuiteAsync()).ToList();
        }
        finally
        {
            LibraryBusy = false;
        }
    }

    private async Task RunConnectionTests()
    {
        ConnectionBusy = true;
        try
        {
            ConnectionResults = (await ConnectionTests.TestConnectionsAsync()).ToList();
        }
        finally
        {
            ConnectionBusy = false;
        }
    }

    private async Task RunMultipleQuery()
    {
        IsBusy = true;
        QueryHasRun = false;
        var timer = System.Diagnostics.Stopwatch.StartNew();
        await Task.Delay(180);
        try { QueryEmployees = Data.QueryEmployees(Department, MinSalary, MaxSalary).ToList(); QueryError = ""; }
        catch (ArgumentException exception) { QueryError = exception.Message; QueryEmployees = []; }
        timer.Stop();
        QueryElapsed = timer.Elapsed.TotalMilliseconds;
        QueryHasRun = true;
        IsBusy = false;
    }

    private void ResetQuery()
    {
        Department = "All Departments";
        MinSalary = null;
        MaxSalary = null;
        QueryEmployees = [];
        QueryHasRun = false;
        ScenarioOutput = "";
    }

    private void ClearQueryResult()
    {
        QueryHasRun = false;
        QueryEmployees = [];
        QueryError = "";
    }

    private async Task RunSingleQuery()
    {
        IsBusy = true;
        SingleHasRun = false;
        await Task.Delay(140);
        var timer = System.Diagnostics.Stopwatch.StartNew();
        SingleEmployee = Data.FindEmployee(LookupId);
        timer.Stop();
        QueryElapsed = timer.Elapsed.TotalMilliseconds;
        SingleHasRun = true;
        IsBusy = false;
    }

    private async Task RunJsonQuery()
    {
        IsBusy = true;
        JsonHasRun = false;
        await Task.Delay(120);
        JsonResult = JsonSerializer.Serialize(Data.GetDataset(DatasetName), new JsonSerializerOptions { WriteIndented = true });
        JsonHasRun = true;
        IsBusy = false;
    }

    private int DatasetCount(string name) => DatasetRows(name).Count;
    private List<JsonElement> DatasetRows(string name)
    {
        var element = JsonSerializer.SerializeToElement(Data.GetDataset(name));
        return element.EnumerateArray().ToList();
    }

    private bool TryGetTable(string name, out TableInfo table, out List<JsonElement> rows)
    {
        table = Tables.FirstOrDefault(item => item.Key.Equals(name, StringComparison.OrdinalIgnoreCase))!;
        rows = [];
        if (table is null) return false;
        rows = DatasetRows(table.Title);
        return true;
    }

    private IEnumerable<JsonElement> FilteredRows(List<JsonElement> rows) =>
        string.IsNullOrWhiteSpace(SearchText)
            ? rows
            : rows.Where(row => row.ToString().Contains(SearchText, StringComparison.OrdinalIgnoreCase));

    private RenderFragment RenderCrud() => @<section>
