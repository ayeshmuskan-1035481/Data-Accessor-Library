<div class="table-scroll"><table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Department</th><th>Salary</th><th>Hire Date</th></tr></thead>
<tbody>@foreach (var employee in Rows) { <tr><td><span class="id-badge">@employee.EmployeeId</span></td><td><strong>@employee.FullName</strong></td><td>@employee.Email</td><td><span class="data-badge">@employee.Department</span></td><td>@employee.Salary.ToString("C0", CultureInfo.GetCultureInfo("en-US"))</td><td>@employee.HireDate.ToString("yyyy-MM-dd")</td></tr>}</tbody></table></div>
@code { [Parameter] public IEnumerable<Employee> Rows { get; set; } = []; }
