    private void InsertCrud()
    {
        if (string.IsNullOrWhiteSpace(FirstName) || string.IsNullOrWhiteSpace(LastName) || string.IsNullOrWhiteSpace(Email) || !Email.Contains('@') || CrudSalary < 0)
        {
            Mutation = new(false, 0, "Enter valid first name, last name, email and a nonnegative salary.");
            return;
        }
        Mutation = Data.InsertEmployee(FirstName, LastName, Email, CrudDepartment, CrudSalary);
        FirstName = LastName = Email = "";
    }
    private void UpdateCrud()
    {
        if (UpdateSalary < 0)
        {
            Mutation = new(false, 0, "Salary must be zero or greater.");
            return;
        }
        Mutation = Data.UpdateEmployee(CrudId, FirstName, LastName, Email, UpdateDepartment, UpdateSalary);
    }
    private void DeleteCrud() => Mutation = Data.DeleteEmployee(CrudId);
    private void BulkCrud() => Mutation = Data.BulkIncrease(CrudDepartment, BulkIncreaseAmount);
    private void ResetCrud() { Data.ResetCrudEmployees(); Mutation = new(true, 8, "Restored the eight-row mock CRUD fixture."); }

