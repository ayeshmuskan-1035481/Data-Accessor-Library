      },
      {
        "Name": "Example1",
        "Provider": "SqlServer",
        "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=Example1;Trusted_Connection=True;TrustServerCertificate=True;",
        "CommandTimeout": 30
      },
      {
        "Name": "Example2",
        "Provider": "SqlServer",
        "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=Example2;Trusted_Connection=True;TrustServerCertificate=True;",
        "CommandTimeout": 30
      }
    ]
  }
}
