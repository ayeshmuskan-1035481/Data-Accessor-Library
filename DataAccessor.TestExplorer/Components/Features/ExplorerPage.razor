    private void SelectScenario(string scenario)
    {
        ScenarioSelection = scenario;
        ScenarioOutput = "";
    }

    private async Task RunScenario()
    {
        IsBusy = true;
        ScenarioOutput = "";
        await Task.Delay(180);
        try
        {
            object result = CurrentPath switch
            {
                "/stored-procedures" => RunMockProcedure(),
                "/unit-of-work" => CreateMockUnitOfWorkResult(),
                "/distributed-transaction" => CreateMockDistributedResult(),
                "/http-data-access" => RunMockHttp(),
                "/composite" => new { routedTo = IsHttpQuery(ScenarioInput) ? "HTTP" : "SQL", reason = IsHttpQuery(ScenarioInput) ? "Input begins with / or http." : "Input does not begin with / or http.", query = ScenarioInput, mode = "Mock prediction" },
                "/multi-server" or "/cross-server" => new { scenario = ScenarioSelection, results = Data.Servers.Select(server => new { server.Name, server.Alias, result = "Mock database name" }), mode = "Mock simulation" },
                "/configuration" => new { source = ScenarioSelection, httpBaseUrl = ScenarioInput, note = "Preview only; no runtime settings changed." },
                "/database-providers" => new { provider = ScenarioSelection, note = "Reference information only; provider was not connected." },
                "/sql-queries" => Data.QueryEmployees("Engineering", null, null),
                "/json-queries" => Data.GetDataset(DatasetName),
                "/advanced-features" or "/data-sources" => new { scenario = ScenarioSelection, mode = "Mock demonstration" },
                _ => new { mode = "Mock demonstration", scenario = ScenarioSelection }
            };
            ScenarioOutput = JsonSerializer.Serialize(result, new JsonSerializerOptions { WriteIndented = true });
        }

        catch (Exception exception) { ScenarioOutput = JsonSerializer.Serialize(new { error = exception.Message, executionMode = "Mock" }, new JsonSerializerOptions { WriteIndented = true }); }
        IsBusy = false;
    }

    private object RunMockProcedure() => ScenarioSelection switch
    {
        "sp_GetEmployeesByDepartment" => Data.QueryEmployees(string.IsNullOrWhiteSpace(ScenarioInput) ? "Engineering" : ScenarioInput, null, null).ToArray(),
        "sp_GetTopSalaries" => Data.Employees.OrderByDescending(employee => employee.Salary).Take(int.TryParse(ScenarioInput, out var top) ? Math.Clamp(top, 1, 5) : 3).ToArray(),
        "sp_GetCustomerOrders" => Data.Orders.Where(order => order.CustomerId == (int.TryParse(ScenarioInput, out var id) ? id : 1)).ToArray(),
        _ => new { procedure = ScenarioSelection, affectedRows = Data.Employees.Count(employee => employee.Department == "Engineering"), note = "Simulated summary; no persisted salary updates." }
    };

    private void OnHttpEndpointChanged()
    {
        ScenarioInput = ScenarioSelection.Contains(' ')
            ? ScenarioSelection[(ScenarioSelection.IndexOf(' ') + 1)..]
            : "";
        ScenarioOutput = "";
    }

    private object RunMockHttp()
    {
        var method = ScenarioSelection.Split(' ')[0];
        var path = string.IsNullOrWhiteSpace(ScenarioInput)
            ? ScenarioSelection[(ScenarioSelection.IndexOf(' ') + 1)..]
            : ScenarioInput;
        object response = path switch
        {
            "/mock/todos/1" => Data.MockTodos[0],
            "/mock/todos" => Data.MockTodos,
            "/mock/users/1" => new { id = 1, name = "Leanne Graham", username = "Bret", email = "leanne@example.test" },
            "/mock/posts" => new[] { new { id = 1, title = "Mock post", body = "Demonstration data", userId = 1 } },
            "/mock/json" => new { message = "Raw JSON mock response", count = 1 },
            _ when method == "POST" => new { id = 101, body = JsonBody },
            _ when method == "PUT" => new { id = 1, body = JsonBody, updated = true },
            _ when method == "DELETE" => new { id = 1, deleted = true },
            _ => new { message = "Mock response; endpoint availability not verified." }
        };
        return new
        {
            method,
            url = path,
            statusCode = method == "POST" ? 201 : 200,
            response
        };
    }

    private object CreateMockUnitOfWorkResult()
    {
        var isRollback = ScenarioSelection == "Rollback on Error";
        var isMultiQuery = ScenarioSelection == "Multi-Query Transaction";
        var steps = isRollback
            ? new[] { "BEGIN", "INSERT staged row", "INSERT invalid column → ERROR", "ROLLBACK (staged write discarded)" }
            : isMultiQuery
                ? new[] { "BEGIN", "QUERY single record", "QUERY JSON results", "COMMIT" }
                : new[] { "BEGIN", "QUERY pending orders", "INSERT order", "UPDATE order status", "COMMIT" };
        return new
        {
            transactionId = Guid.NewGuid().ToString("N")[..8],
            status = isRollback ? "rolled-back" : "committed",
            startedAt = DateTimeOffset.Now,
            endedAt = DateTimeOffset.Now,
            steps,
            mode = "Mock simulation; no persistence verified"
        };
    }

    private object CreateMockDistributedResult()
    {
        var rollback = ScenarioSelection == "Rollback on Error";
        return new
        {
            success = !rollback,
            scenario = ScenarioSelection,
            servers = new[]
            {
                new { name = "OrdersDB", status = rollback ? "rolled-back" : "committed", command = rollback ? "valid command; rolled back" : "sample order write" },
                new { name = "ProductsDB", status = rollback ? "error" : "committed", command = rollback ? "invalid SQL; caused rollback" : "sample product write" }
            },
            note = "Mock simulation; sequential local transactions do not prove two-phase atomicity."
        };
    }

    private static bool IsHttpQuery(string? query) =>
        query?.StartsWith('/') == true || query?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true;

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}

