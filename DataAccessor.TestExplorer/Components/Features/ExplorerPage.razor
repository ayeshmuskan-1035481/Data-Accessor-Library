                    {
                        <label>Employee ID<input type="number" min="1" @bind="CrudId" /></label><label>First name (optional)<input @bind="FirstName" /></label><label>Last name (optional)<input @bind="LastName" /></label><label>Email (optional)<input type="email" @bind="Email" /></label><label>Department (optional)<input @bind="UpdateDepartment" /></label><label>Salary (optional; blank means unchanged)<input type="number" min="0" step="100" @bind="UpdateSalary" /></label><button class="button primary" @onclick="UpdateCrud">Update Employee</button>
